        color: parent.color
        clip: true
        visible: showBookDetails // Use state property

        Rectangle{
            id: bookTitleRect
            width: parent.width* 2/3
            height: 50
            anchors{
                top: parent.top
                topMargin: 10
                horizontalCenter: parent.horizontalCenter
            }
            color: "transparent"
            clip: true

            Text{
                id: bookTitle
                width: parent.width
                anchors{
                    left: parent.left
